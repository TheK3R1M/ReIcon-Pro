<Window x:Class="DesktopIconLayoutManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RootWindow"
        Title="ReIcon Pro - Masaüstü Simge Yöneticisi" 
        Height="620" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Segoe UI Variable"
        Icon="app.ico"
        StateChanged="RootWindow_StateChanged"
        Closing="RootWindow_Closing">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Action / Save Card -->
            <RowDefinition Height="Auto"/>
            <!-- Search & Filter Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Profiles List Section -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <!-- App Icon Badge -->
                        <Border Width="36" Height="36" Background="#1E293B" CornerRadius="8" Margin="0,0,12,0" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1.5">
                            <TextBlock Text="🖥️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtAppTitle" Text="ReIcon Pro" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtAppSubtitle" Text="Masaüstü simge düzenlerinizi kaydedin, çözünürlük değişikliklerinde anında geri yükleyin." FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Right Header Actions (Language Switcher & AutoArrange Badge) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Selector Buttons -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="4" Margin="0,0,12,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnLangTR" Content="🇹🇷 TR" Padding="8,4" FontSize="11" FontWeight="Bold"
                                    Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnLangTR_Click">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                            <Button x:Name="BtnLangEN" Content="🇬🇧 EN" Padding="8,4" FontSize="11" FontWeight="Bold" Margin="4,0,0,0"
                                    Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" Cursor="Hand" Click="BtnLangEN_Click">
                                <Button.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Auto-Arrange Badge -->
                    <Border x:Name="AutoArrangeBadge" Background="#1E293B" CornerRadius="20" Padding="12,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="BadgeDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                            <TextBlock x:Name="BadgeText" Text="Auto-Arrange: Pasif" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Save New Layout Card -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock x:Name="TxtNewLayoutTitle" Text="Yeni Düzen Kaydet" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBox x:Name="ProfileNameInput" Height="40" Padding="12,9" FontSize="13" 
                             Background="#0F172A" Foreground="{StaticResource TextPrimaryBrush}" 
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                             GotFocus="ProfileNameInput_GotFocus" LostFocus="ProfileNameInput_LostFocus">
                        <TextBox.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <Button Grid.Column="1" x:Name="SaveButton" Content="📸 Düzeni Kaydet" Height="40" Width="160" 
                        VerticalAlignment="Bottom" FontWeight="Bold" FontSize="13"
                        Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="SaveButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Search Bar & List Header -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" x:Name="TxtSavedProfilesTitle" Text="Kaydedilmiş Düzenler" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

            <!-- Search Input Box -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,6,0"/>
                    <TextBox Grid.Column="1" x:Name="SearchInput" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" 
                             BorderThickness="0" FontSize="12" VerticalAlignment="Center" TextChanged="SearchInput_TextChanged"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Profiles List Section -->
        <Border Grid.Row="3" Background="{StaticResource CardBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16" Padding="6">
            <ListView x:Name="ProfilesListView" Background="Transparent" BorderThickness="0" 
                      Foreground="{StaticResource TextPrimaryBrush}" SelectionMode="Single"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="260">
                            <GridViewColumnHeader x:Name="HeaderName" Content="Düzen Adı"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <TextBlock Text="📑" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="160">
                            <GridViewColumnHeader x:Name="HeaderDate" Content="Tarih"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="130">
                            <GridViewColumnHeader x:Name="HeaderResolution" Content="Çözünürlük"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ResolutionDisplay}" FontSize="11" Foreground="#38BDF8" HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="100">
                            <GridViewColumnHeader x:Name="HeaderIcons" Content="Simge"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#0F172A" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icons.Count, StringFormat='{}{0} simge'}" FontSize="11" Foreground="#A7F3D0" HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="170">
                            <GridViewColumnHeader x:Name="HeaderActions" Content="İşlemler"/>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <Button x:Name="BtnRowRestore" Content="⚡ Yükle" Padding="10,5" Margin="0,0,6,0" FontSize="11" FontWeight="Bold"
                                                Background="{StaticResource SuccessBrush}" Foreground="White" 
                                                BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="RestoreButton_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button x:Name="BtnRowDelete" Content="🗑️ Sil" Padding="10,5" FontSize="11" FontWeight="Bold"
                                                Background="{StaticResource DangerBrush}" Foreground="White" 
                                                BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="DeleteButton_Click">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="14,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBarText" Text="Hazır." FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="ReIcon Pro v1.0 • System Tray Active" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
